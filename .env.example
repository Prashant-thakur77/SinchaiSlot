# Every key is optional. With none set, the whole platform runs on local simulators.

# Database (docker compose sets this; default outside Docker is a local SQLite file)
# DATABASE_URL=postgresql+psycopg://sinchai:sinchai@localhost:5432/sinchai
# REDIS_URL=redis://localhost:6379/0
# MQTT_HOST=localhost

# LLM: "rules" (offline, default) or "anthropic" (uses ANTHROPIC_API_KEY or an `ant auth login` profile)
LLM_PROVIDER=rules
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Speech: "text" (offline) or "http" (hosted Indic ASR/TTS endpoints)
SPEECH_PROVIDER=text
# SPEECH_ASR_URL=
# SPEECH_TTS_URL=
# SPEECH_API_KEY=

# Channels: "sim" (local simulators) or provider adapters
IVR_PROVIDER=sim
# IVR_API_URL=
# IVR_API_KEY=
WHATSAPP_PROVIDER=sim
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
UPI_VPA=sinchaislot@testbank

# Database password inside docker compose (default: sinchai, never exposed outside the compose network)
# POSTGRES_PASSWORD=

# Shared secret for offline unlock codes; change for any real deployment
# EDGE_SECRET=
# Bearer token for operator and funder API routes
# API_TOKEN=
